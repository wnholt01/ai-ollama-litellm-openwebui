{
  "mcpServers": {
    "gmail": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://gmailmcp.googleapis.com/mcp/v1",
        "--client-id",
        "${GOOGLE_OAUTH_CLIENT_ID}",
        "--client-secret",
        "${GOOGLE_OAUTH_CLIENT_SECRET}",
        "--callback-port",
        "3334"
      ],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
        "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}"
      }
    }
  }
}
